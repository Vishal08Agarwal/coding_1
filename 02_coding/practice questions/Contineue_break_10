#include <bits/stdc++.h>
using namespace std;

int main() {
    int no;
    double avg;
int c=0,sum=0;
while(cin>>no){
    if(no==0)
    break;
    if(no<0)
    continue;
    sum+=no;
    c++;
}
avg=sum/c;
cout<< "number of positive input "<<c<<endl;
cout<< "sum of positive input "<<sum<<endl;
cout<< "Average of positive input "<<avg<<endl;
return 0;
}