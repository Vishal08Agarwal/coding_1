#include <bits/stdc++.h>
using namespace std;

int main() {
    int sec,day,min,hour;
    cin>>sec;
    if(sec>=86400){
        day=sec/86400;
        sec=sec-day*86400;
    }
    if(sec>=3600){
    hour=sec/3600;
    sec=sec-hour*3600;
    }
    if(sec>=60){
        min=sec/60;
        sec=sec-min*60;
    }
    
    cout<<day <<"days "<<hour<<":"<<min<<":"<<sec;
}
