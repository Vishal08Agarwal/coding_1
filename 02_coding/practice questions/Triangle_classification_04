#include <bits/stdc++.h>
using namespace std;

int main() {
	double a,b,c;
	cin>>a>>b>>c;
	if((a+b>c)&&(c+b>a)&&(a+c>b))
	{
	    if(a==b&&b==c&&a==c)
	    cout<<"equitorial triangle";
	    else if((a==b)||(a==c)||(b==c)){
	    if((a*a + b*b==c*c)||(c*c + b*b==a*a)||(a*a + c*c==b*b))
	    cout<<"Isosceles right angle triangle ";
	    else
	    cout<<"Isosceles non- right angle triangle";
	        
	    }
	    else if((a*a + b*b==c*c)||(c*c + b*b==a*a)||(a*a + c*c==b*b))
	    cout<<"Scalen right angle triangle ";
	    else
	        cout<<"Scalen right angle triangle ";
	    }
	else
	cout<<"invalid sides";
	return 0;
}