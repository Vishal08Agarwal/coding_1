#include <bits/stdc++.h>
using namespace std;

int main() {
	int n;
	cin>>n;
	// for top Structure
	for(int i=0;i<n;i++)
	{
	    //for first * triangle
	    for(int j=0;j<(i+1);j++)
	    {
        	cout<< '*';
	    }
	     //for space
	    if(i !=n-1)
	    {
	        int s=2*(n-1-i);
	    for(int j=1;j<=s;j++){
	    cout<<" ";
	    }
	    }
	     //for second * triangle
	    for(int j=0;j<(i+1);j++){
	        cout<<'*';
	    }
	    cout<<endl;
	}
	    // for bottom Structure
	    for(int i=0;i<n;i++)
	{
	    //for first * triangle
	    for(int j=(n-i);j>0;j--)
	    {
        	cout<< '*';
	    }
	     //for space
	    if(i !=0)
	    {
	        int s=2*(i);
	    for(int j=1;j<=s;j++){
	    cout<<" ";
	    }
	    }
	     //for second * triangle
	    for(int j=n;j>i;j--){
	        cout<<'*';
	    }
	    cout<<endl;
    }
return 0;
}