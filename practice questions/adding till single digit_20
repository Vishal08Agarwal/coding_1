#include <bits/stdc++.h>
using namespace std;

int main() {
    int no;
    cin>>no;
   while(no>0){
        int c=0,sum=0,temp=0;
        int t=no;
        while(t>0){
        c++;
        t=t/10;
        }
        if(c>1){
            while(no>0){
            temp=no%10;
            sum+=temp;
            no=no/10;
            }
        }
        else
        break;
        no=sum;
        cout<<no<<endl;
   }
    
    return 0;
}