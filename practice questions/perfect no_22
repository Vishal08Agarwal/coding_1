#include <bits/stdc++.h>
using namespace std;

int main() { //6=1+2+3; is a perfect number
    for(int i=1;i<=10000;i++)
    {
        int sum=0;
        for(int j=1;j<i;j++)
        {
            if(i%j==0)
            sum+=j;
            
        }
        if(sum==i)
        cout<<i<<" is a perfect number"<<endl;
    }
    
    return 0;
}