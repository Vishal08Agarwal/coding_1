#include <iostream>
using namespace std;
int main()
{
int d,t;
cin>>t;
d=t;
if(t<=24)
{
    if(t==24||t==0)
        cout<<"Time is "<< 12 <<" AM";
    else if(t==12)
        cout<<"Time is "<< 12 <<" PM";
    else if(t<=12)
        cout<<"Time is "<< t <<" AM";
    else
        t=t-12;
        cout<<"Time is " << t <<" PM";
}
else
cout<<"invalid data";
cout<<endl;
switch (d){
    case 5:case 6:case 7:case 8:case 9:case 10:case 11:
    cout<<"Good morning";
    break;
    case 12:case 13:case 14:case 15:case 16:
    cout<<"Good afternoon ";
    break;
    case 17:case 18:case 19:case 20:
    cout<<"Good evening ";
    break;
    default:
    cout<<"Good night";
}

return 0;    
}