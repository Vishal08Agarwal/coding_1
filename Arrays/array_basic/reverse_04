#include <bits/stdc++.h>
using namespace std;

int main() {
    int num[]={3,-5,1,34,2};
    int size =sizeof(num)/sizeof(int);
    int st=0,end=size-1;
    while(st<end){
        swap(num[st],num[end]);
        st++;
        end--;
    }
    for(int i=0;i<size;i++){
         cout<<num[i]<<",";
    }
    return 0;
}