#include <bits/stdc++.h>
using namespace std;

int linearsearch(int num[],int size,int tar){
    for(int i=0;i<size;i++){
        if(tar==num[i]){
           return i;
        }
    }
    return -1;
}

int main() {
    int num[]={3,-5,1,34,2};
    int size =sizeof(num)/sizeof(int);
    int tar=32;
    cout<<linearsearch(num,size,tar)<<endl;
}
