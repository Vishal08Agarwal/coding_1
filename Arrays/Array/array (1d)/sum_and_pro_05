#include <bits/stdc++.h>
using namespace std;

int main() {
    int num[]={3,-5,1,34,2};
    int size =sizeof(num)/sizeof(int);
        int sum=0,pro=1;
    for(int i=0;i<size;i++){
         sum+=num[i];
         pro*=num[i];
    }
    cout<<"sum is"<<sum<<endl;
    cout<<"product is"<< pro;
    return 0;
}