#include <bits/stdc++.h>
using namespace std;

int main(){
    int n;
    cin>>n;
    for(int i=1;i<=n;i++){
        if(i!=1){
        for(int j=1;j<i;j++){
            cout<<"  ";
        }
        }
        for(int j=5;j>=i;j--){
            cout<<j<<" ";
        }
        cout<<endl;
    }
    return 0;
}


